{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "LoginProtection": {
      "MaxFailedAttempts": 5,
      "LockoutMinutes": 15,
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Session": {
      "LifetimeMinutes": 30
    }
  }
}
